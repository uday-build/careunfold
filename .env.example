# Copy to .env.local. Do not put real secrets in this file.

# PostgreSQL started with: docker compose up -d
DATABASE_URL=postgres://careunfold:careunfold@localhost:5432/careunfold

# Fallback when Docker is not available. Same SQL migrations, stored under .data/pglite.
# DATABASE_URL=pglite:./.data/pglite

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

# Google or email address that can open Admin and approve access. Comma-separated if needed.
ADMIN_EMAIL=

# Leave blank until a Google OAuth client exists. Both values are required or Google stays off.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank to keep inbox delivery off.
# EMAIL_DELIVERY=dev-sink stores messages locally at /dev/outbox and is refused in production.
# EMAIL_DELIVERY=memory is for automated tests only.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DELIVERY=dev-sink

# Used only by npm run db:seed:synthetic. At least 12 characters. Never commit a real value.
SYNTHETIC_FIXTURE_PASSWORD=
